+/* One row of the EXTRAS card (GameInfo.host_extras): a host-owned option
+ * that needs a file or a folder, such as a fan patch or an MSU-1 pack. The
+ * host owns and persists every value; the launcher only draws the row and
+ * calls back. Every callback may be NULL. */
+typedef struct RecompLauncherHostExtra {
+    const char*        label;          /* checkbox text */
+    const char*        help;           /* hover text on the checkbox */
+    int                pick_folder;    /* Browse picks a folder (1) or a file (0) */
+    const char*        pick_title;
+    const char* const* pick_patterns;  /* file filters, e.g. "*.ips" */
+    int                pick_pattern_count;
+    const char*        pick_description;
+    int              (*get_enabled)(void);
+    void             (*set_enabled)(int on);
+    const char*      (*get_path)(void);           /* shown under the row */
+    void             (*set_path)(const char* path); /* the host checks and keeps it */
+    /* Status line under the path; *level: 0 = plain, 1 = good, 2 = problem. */
+    const char*      (*status)(int* level);
+    /* Optional sub-options, drawn indented under the row while it is on. */
+    int              (*sub_count)(void);
+    const char*      (*sub_label)(int index);
+    int              (*sub_get)(int index);
+    void             (*sub_set)(int index, int on);
+} RecompLauncherHostExtra;
