+// EXTRAS card (GameInfo.host_extras): host-owned options with a file or a
+// folder. Each row: checkbox, Browse, the chosen path, the host's status line
+// and, while the row is on, its sub-options. Values are the host's: read on
+// every draw, written back through the callbacks.
+int avail_host_extras(const LauncherModel* m) {
+    return m && m->host_extras && m->num_host_extras > 0;
+}
+
+void panel_host_extras_draw(LauncherModel* m, const LauncherTheme* thp) {
+    const LauncherTheme& th = *thp;
+    if (begin_panel("extras", 0)) {
+        eyebrow(m->host_extras_title && m->host_extras_title[0]
+                    ? m->host_extras_title : "EXTRAS");
+        for (int i = 0; i < m->num_host_extras; ++i) {
+            const RecompLauncherHostExtra* e = &m->host_extras[i];
+            ImGui::PushID(i);
+            if (i > 0) ImGui::Dummy(ImVec2(0, px(6)));
+            const bool on = e->get_enabled && e->get_enabled() != 0;
+            bool v = on;
+            if (ImGui::Checkbox(ui_text(e->label ? e->label : "Option"), &v) &&
+                e->set_enabled)
+                e->set_enabled(v ? 1 : 0);
+            if (e->help && e->help[0] && ImGui::IsItemHovered()) {
+                ImGui::BeginTooltip();
+                ImGui::PushTextWrapPos(px(380));
+                ImGui::TextUnformatted(e->help);
+                ImGui::PopTextWrapPos();
+                ImGui::EndTooltip();
+            }
+            if (e->set_path) {
+                const float bw = px(78);
+                ImGui::SameLine(ImGui::GetCursorPosX() +
+                                ImGui::GetContentRegionAvail().x - bw);
+                if (ImGui::Button(ui_text("Browse"), ImVec2(bw, px(28)))) {
+                    auto set = e->set_path;
+                    if (e->pick_folder) {
+                        ui_pick_folder(m, e->pick_title, [set](const char* p) {
+                            if (p) set(p);
+                        });
+                    } else {
+                        std::vector<std::string> pats;
+                        for (int k = 0; e->pick_patterns && k < e->pick_pattern_count; ++k)
+                            if (e->pick_patterns[k]) pats.emplace_back(e->pick_patterns[k]);
+                        ui_pick_file(m, e->pick_title, std::move(pats), e->pick_description,
+                                     [set](const char* p) { if (p) set(p); });
+                    }
+                }
+            }
+            const char* path = e->get_path ? e->get_path() : NULL;
+            char elided[384];
+            elide_left(path && path[0] ? path : ui_text("(not set)"),
+                       ImGui::GetContentRegionAvail().x, elided, sizeof(elided));
+            ImGui::TextColored(col(th.text_muted), "%s", elided);
+            if (path && path[0] && ImGui::IsItemHovered()) ImGui::SetTooltip("%s", path);
+            if (e->status) {
+                int level = 0;
+                const char* st = e->status(&level);
+                if (st && st[0]) {
+                    ImGui::PushStyleColor(ImGuiCol_Text,
+                        col(level == 1 ? th.good : level == 2 ? th.warn : th.text_muted));
+                    ImGui::PushTextWrapPos(0.0f);
+                    ImGui::TextUnformatted(st);
+                    ImGui::PopTextWrapPos();
+                    ImGui::PopStyleColor();
+                }
+            }
+            const int subs = e->sub_count ? e->sub_count() : 0;
+            if (on && subs > 0 && e->sub_label) {
+                ImGui::Indent(px(22));
+                for (int k = 0; k < subs; ++k) {
+                    ImGui::PushID(1000 + k);
+                    bool sv = e->sub_get && e->sub_get(k) != 0;
+                    if (ImGui::Checkbox(ui_text(e->sub_label(k)), &sv) && e->sub_set)
+                        e->sub_set(k, sv ? 1 : 0);
+                    ImGui::PopID();
+                }
+                ImGui::Unindent(px(22));
+            }
+            ImGui::PopID();
+        }
+    }
+    end_panel();
+}
